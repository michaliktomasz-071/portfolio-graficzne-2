# Pliki binarne — git nie modyfikuje końców linii (chroni PDF/grafiki przed uszkodzeniem)
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.woff2 binary

# Pliki tekstowe — normalizacja do LF w repo
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.svg  text eol=lf
*.json text eol=lf
*.md   text eol=lf
